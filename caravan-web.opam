# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.0"
synopsis: "Web dashboard, JSON API and Prometheus metrics for Caravan"
maintainer: ["Nana Kwadwo <nkwadwo06@gmail.com>"]
authors: ["Nana Kwadwo <nkwadwo06@gmail.com>"]
license: "MIT"
homepage: "https://github.com/naamanu/caravan"
doc: "https://naamanu.github.io/caravan"
bug-reports: "https://github.com/naamanu/caravan/issues"
depends: [
  "dune" {>= "3.17"}
  "caravan" {= version}
  "cohttp-eio" {>= "6.0"}
  "http" {>= "6.0"}
  "base64" {>= "3.0"}
  "uri" {>= "4.0"}
  "yojson" {>= "2.1"}
  "ptime" {>= "1.1"}
  "logs" {>= "0.7"}
  "eio_main" {with-test}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/naamanu/caravan.git"
