# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Durable, distributed background jobs for OCaml 5 and Eio"
description:
  "Caravan is a durable job queue: producers enqueue jobs to shared storage and workers on many nodes claim and execute them with retries, scheduling, priorities, uniqueness, cron and graceful shutdown. Delivery is at-least-once."
maintainer: ["Nana Kwadwo <nkwadwo06@gmail.com>"]
authors: ["Nana Kwadwo <nkwadwo06@gmail.com>"]
license: "MIT"
homepage: "https://github.com/naamanu/caravan"
doc: "https://naamanu.github.io/caravan"
bug-reports: "https://github.com/naamanu/caravan/issues"
depends: [
  "dune" {>= "3.17"}
  "ocaml" {>= "5.2"}
  "eio" {>= "1.2"}
  "yojson" {>= "2.1"}
  "ptime" {>= "1.1"}
  "mtime" {>= "2.0"}
  "logs" {>= "0.7"}
  "fmt" {>= "0.9"}
  "eio_main" {with-test}
  "alcotest" {with-test}
  "qcheck-core" {with-test}
  "qcheck-alcotest" {with-test}
  "ppx_deriving_yojson" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/naamanu/caravan.git"
