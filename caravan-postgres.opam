# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "PostgreSQL backend for Caravan"
description:
  "Stores Caravan jobs in PostgreSQL, claims work with FOR UPDATE SKIP LOCKED, wakes workers with LISTEN/NOTIFY and supports transactional enqueue. Talks to libpq directly, driven non-blocking by Eio."
maintainer: ["Nana Kwadwo <nkwadwo06@gmail.com>"]
authors: ["Nana Kwadwo <nkwadwo06@gmail.com>"]
license: "MIT"
homepage: "https://github.com/naamanu/caravan"
doc: "https://naamanu.github.io/caravan"
bug-reports: "https://github.com/naamanu/caravan/issues"
depends: [
  "dune" {>= "3.17"}
  "caravan" {= version}
  "postgresql" {>= "5.0"}
  "uri" {>= "4.0"}
  "eio_main" {with-test}
  "alcotest" {with-test}
  "qcheck-core" {with-test}
  "qcheck-alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/naamanu/caravan.git"
